{
  "expo": {
    "name": "Math Fun",
    "slug": "math-fun",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-dontwarn com.facebook.react.turbomodule.**"
          }
        }
      ]
    ],
    "android": {
      "package": "com.mathfun.app",
      "adaptiveIcon": {
        "backgroundColor": "#2E9E6B"
      }
    },
    "extra": {
      "eas": {
        "projectId": "5e99ea15-7c10-4812-a669-1042bbdae453"
      }
    }
  }
}
